# MongoDB Atlas — строка подключения из Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/warehouse_project_server?retryWrites=true&w=majority

# Секрет для JWT — минимум 32 символа, генерируй случайно
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# URL фронтенда на Vercel (без слэша в конце, через запятую если несколько)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# PORT выставляет Railway автоматически — не нужно задавать вручную
